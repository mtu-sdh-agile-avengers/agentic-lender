# Agentic Lender: every variable the stack reads, in one place.
#
# Docker Compose: copy this file to `.env` in the repo root. Compose reads it
# automatically. Every value has a working default in docker-compose.yml, so
# only fill in what you need (LLM keys, a private Hugging Face token).
#
# Running a service on its own (no Docker)? Each service also has its own
# .env.example: api/.env.example, ai/.env.example, web/.env.example.
#
# Never commit `.env`; it is gitignored.

# ---------------------------------------------------------------------------
# Shared (Phase 0 decisions)
# ---------------------------------------------------------------------------

# Which Firebase the whole stack uses:
#   emulator  local emulator suite, no credentials, data reset on every start (default)
#   cloud     the real Firebase project "agentic-lender" (needs the values below)
# AL-Core, AL-Web and AL-Mobile must use the same mode, or tokens are rejected.
FIREBASE_MODE=emulator

# Emulator project. "demo-" prefix = emulators only, never real Firebase.
FIREBASE_PROJECT_ID=demo-agentic-lender

# Shared secret between AL-Core and AL-AI Engine (sent as X-Internal-Key).
# Same value on both sides. Change it for anything other than local dev.
INTERNAL_API_KEY=al-dev-internal-key

# ---------------------------------------------------------------------------
# Real Firebase (FIREBASE_MODE=cloud). Ask Pavlo/Hlib for the values; never
# commit them. Web app config: Firebase Console -> Project settings -> Your apps.
# Plus the service account key file in api/secrets/ (see api/secrets/README.md).
# ---------------------------------------------------------------------------

FIREBASE_CLOUD_PROJECT_ID=agentic-lender
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=agentic-lender.firebaseapp.com
FIREBASE_WEB_APP_ID=
# Firestore database ID in the real project (firebase.json: "database")
FIRESTORE_PROD_DATABASE_NAME=default

# ---------------------------------------------------------------------------
# AL-AI Engine (ai/)
# ---------------------------------------------------------------------------

# Valuation model, downloaded once from Hugging Face Hub and cached in a volume
HF_REPO_ID=mtu-sdh-agile-avengers/agentic_lender
HF_MODEL_FILENAME=avm_v1.joblib
HF_REVISION=main
# only if the model repo is private
HF_TOKEN=

# LLM providers: only needed for deliberations (not used this sprint)
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=
OLLAMA_MODEL=llama3.2
# Ollama on the host machine, seen from inside the ai container
OLLAMA_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# Set by docker-compose.yml itself (listed for reference, do not override)
# ---------------------------------------------------------------------------
#
# AL-Core (api/)
#   RUN_MODE=dev
#   FIRESTORE_EMULATOR_HOST=firebase:8080
#   FIREBASE_AUTH_EMULATOR_HOST=firebase:9099
#   CORS_ORIGINS=["http://localhost:5173", ...]
#   AI_ENGINE_URL=http://ai:8001
#   FIREBASE_MODE=<from above>
#   GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase/service-account.json  (cloud only)
#
# AL-AI Engine (ai/)
#   CORE_BASE_URL=http://api:8000
#
# AL-Web (web/), seen from the browser on your machine
#   VITE_FIREBASE_MODE=<FIREBASE_MODE>
#   VITE_FIREBASE_EMULATOR_PROJECT_ID=demo-agentic-lender
#   VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
#   VITE_FIREBASE_PROJECT_ID / _API_KEY / _AUTH_DOMAIN / _APP_ID  <- the cloud values above
#   VITE_API_BASE_URL=http://localhost:8000
#
# AL-Mobile (mobile/, runs outside Docker). Gradle properties with defaults for
# the Android emulator; override in ~/.gradle/gradle.properties for a phone:
#   al.apiBaseUrl=http://10.0.2.2:8000
#   al.emulatorHost=10.0.2.2
#   al.firebaseMode=emulator            (cloud: also al.firebaseApiKey, al.firebaseAppId)
