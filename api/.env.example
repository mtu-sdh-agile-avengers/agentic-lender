RUN_MODE=dev

# web dev server (Vite) runs on 5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Firebase
# Service account key: required for RUN_MODE=prod. Leave empty in dev, the emulators need no real credentials.
GOOGLE_APPLICATION_CREDENTIALS=
FIRESTORE_PROD_DATABASE_NAME=
# must match `firebase emulators:start --project ...` and the clients' project ID
FIREBASE_PROJECT_ID=demo-agentic-lender
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"

# AL-AI Engine; INTERNAL_API_KEY must equal the AI engine's value
AI_ENGINE_URL=http://localhost:8001
INTERNAL_API_KEY=al-dev-internal-key
