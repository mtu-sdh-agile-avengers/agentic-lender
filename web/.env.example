# AL-Web configuration for `npm run dev` outside Docker. Copy to .env.local.
# (Docker Compose sets these itself.)

# Local development against the shared Firebase emulator suite.
# For the real project set VITE_USE_EMULATORS=false and fill in the values below
# (Firebase Console -> Project settings -> Your apps; never commit them).
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-agentic-lender
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# AL-Core REST API
VITE_API_BASE_URL=http://localhost:8000

# Only for the real Firebase project (VITE_USE_EMULATORS=false);
# then VITE_FIREBASE_PROJECT_ID=agentic-lender
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
