# AL-AI Engine configuration. Copy to .env and fill in.
# Running with Docker Compose? Use the root .env instead: compose passes these
# variables in and this file is not copied into the image.

# Shared secret: AL-Core sends it as X-Internal-Key. Must equal AL-Core's value.
INTERNAL_API_KEY=al-dev-internal-key
CORE_BASE_URL=http://localhost:8000

# Valuation model. A local ml/models/avm_v1.joblib wins; otherwise it is
# downloaded once from Hugging Face Hub and cached.
HF_REPO_ID=mtu-sdh-agile-avengers/agentic_lender
HF_MODEL_FILENAME=avm_v1.joblib
HF_REVISION=main
HF_TOKEN=

# LLM providers (deliberations only; the service starts without them)
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434
